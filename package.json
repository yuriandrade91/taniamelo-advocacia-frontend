{
  "name": "tania-melo-advocacia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:local",
    "dev:local": "dotenv -e env/local.env -- next dev --turbopack --port 3001",
    "dev:development": "dotenv -e env/development.env -- next dev --turbopack --port 3001",
    "build": "next build",
    "build:development": "dotenv -e env/development.env -- next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e env/local.env -- playwright test",
    "test:e2e:dev": "dotenv -e env/development.env -- playwright test",
    "test:e2e:ui": "dotenv -e env/local.env -- playwright test --ui"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@internationalized/date": "3.12.2",
    "@react-aria/i18n": "3.12.14",
    "@tiptap/extension-character-count": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "animate.css": "^4.1.1",
    "axios": "^1.9.0",
    "chart.js": "^4.5.1",
    "next": "16.2.12",
    "react": "^19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.1",
    "swapy": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
