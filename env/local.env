# Backend rodando na máquina local, escritório `tania` (massa semeada por
# `db/mock-data/seed_tenant_tania.sql`).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_TENANT_SLUG=tania

# Mostra o campo "Escritório" no login: aqui qualquer slug pode existir, e o
# digitado vale no lugar do padrão acima. Nos outros ambientes fica desligado.
NEXT_PUBLIC_TENANT_PICKER=true

# Integrações em pausa: nenhuma.
#
# Este backend é o do repositório, então ele tem tudo o que o front chama. Não
# defina `NEXT_PUBLIC_PENDING_INTEGRATIONS` aqui — a linha existe só para
# lembrar que o padrão é "tudo ligado", e que pausar é decisão de ambiente.
