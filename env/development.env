# Backend remoto de desenvolvimento (EC2), escritório `tania`.
#
# `tania` nesta instância é massa semeada — 125 clientes fictícios e os
# usuários `dra.tania` e `ana.souza` de `db/mock-data/seed_tenant_tania.sql`.
# Não é o escritório em produção. É por isso que a suíte de ponta a ponta pode
# rodar aqui: ela cria, edita e exclui registros, e o que ela apaga é ficção.
#
# Se um dia esta instância passar a servir dados reais, este arquivo deixa de
# ser alvo de teste — e o `tenant_demo` volta a ser o lugar da suíte.
NEXT_PUBLIC_API_URL=http://98.82.73.175:8080
NEXT_PUBLIC_TENANT_SLUG=tania

# Integrações em pausa nesta instância.
#
# Ela está uma build atrás: `/users/me`, `/payments`, `/expenses`, `/revenues`
# e `/cep` existem no repositório e respondem 404 aqui. Sem esta linha, as telas
# erram a cada carregamento e a pessoa não sabe se é defeito ou ambiente.
#
# Depois do deploy, apague a linha inteira — é a única coisa a fazer, o código
# das telas nunca saiu do lugar.
NEXT_PUBLIC_INTEGRACOES_PENDENTES=users-me,payments,expenses,revenues,cep
