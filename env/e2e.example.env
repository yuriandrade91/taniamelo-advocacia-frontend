# Credenciais da suíte e2e. Copie para env/e2e.local.env (ignorado pelo git) e
# preencha; o playwright.config.ts carrega esse arquivo sozinho. Variáveis já
# exportadas no shell ou vindas do CI têm precedência sobre ele.
#
# Use contas do escritório `tania` (o NEXT_PUBLIC_TENANT_SLUG dos env/*.env) —
# a massa semeada do backend traz uma ADMIN e uma STAFF, ver o README dele.

# Obrigatório: conta ADMIN.
E2E_USER=
E2E_PASSWORD=

# Opcional: conta STAFF. Sem ela, papeis.spec e financeiro-restrito.spec se pulam.
E2E_USER_STAFF=
E2E_PASSWORD_STAFF=

# Opcional: UUID do escritório para a limpeza via API (sem ele, usa o slug).
E2E_TENANT_ID=
